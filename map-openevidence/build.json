{
  "template": "template-openevidence.html",
  "out": "openevidence-cartographer.html",
  "shelves": [
    {"when": [["status", "eq", "ghost"]], "shelf": "Ghosts"},
    {"when": [["type", "in", ["tension", "gradient"]]], "shelf": "Tensions & gradients"},
    {"when": [["type", "eq", "decision"]], "shelf": "Decisions"},
    {"when": [["type", "eq", "jurisdiction"]], "shelf": "Jurisdictions"},
    {"when": [["subtype", "contains", "revenue stream"]], "shelf": "Revenue streams"},
    {"when": [["subtype", "contains", "value proposition"]], "shelf": "Value propositions"},
    {"when": [["subtype", "contains", "key activity"]], "shelf": "Key activities"},
    {"when": [["subtype", "contains", "product"]], "shelf": "Key activities"},
    {"when": [["subtype", "contains", "channel"]], "shelf": "Channels"},
    {"when": [["subtype", "contains", "cost structure"]], "shelf": "Cost structure"},
    {"when": [["subtype", "contains", "key resource"]], "shelf": "Key resources"},
    {"when": [["type", "eq", "shared resource"]], "shelf": "Key resources"},
    {"when": [["type", "eq", "capability"]], "shelf": "Capabilities"},
    {"when": [["type", "eq", "instrument"]], "shelf": "Instruments"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "customer"]], "shelf": "Customer segments"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "user"]], "shelf": "Customer segments"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "capital"]], "shelf": "Investors"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "investor"]], "shelf": "Investors"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "funder"]], "shelf": "Investors"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "partner"]], "shelf": "Key partners"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "infrastructure"]], "shelf": "Key partners"},
    {"when": [["type", "eq", "actor"], ["sub_or_kind", "contains", "competitor"]], "shelf": "Competitive context"},
    {"when": [["type", "eq", "actor"]], "shelf": "Actors"},
    {"when": [], "shelf": "Emergent"}
  ]
}
