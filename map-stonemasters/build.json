{
  "template": "template-stonemasters.html",
  "out": "stonemasters-cartographer.html",
  "shelves": [
    {"when": [["status", "eq", "ghost"]], "shelf": "Ghosts"},
    {"when": [["type", "in", ["tension", "gradient"]]], "shelf": "Evaluative"},
    {"when": [["type", "eq", "decision"]], "shelf": "Decisions"},
    {"when": [["type", "eq", "shared resource"]], "shelf": "Shared resources"},
    {"when": [["type", "eq", "capability"]], "shelf": "Capabilities"},
    {"when": [["type", "eq", "actor"]], "shelf": "People & parties"},
    {"when": [], "shelf": "Emergent"}
  ]
}
